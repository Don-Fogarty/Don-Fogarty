SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_TARGET_USER_ID=U0123456789
SLACK_CHANNELS=#sales,#product,#marketing-growth,#marketing-brand,#customer-success,#customer-support,#shipped

# Schedules in GMT
TIMEZONE=Etc/GMT
DAILY_HOUR_GMT=8
DAILY_MINUTE_GMT=0
WEEKLY_DAY_OF_WEEK=fri
WEEKLY_HOUR_GMT=16
WEEKLY_MINUTE_GMT=0

# Pull limits and source links
MAX_MESSAGES_PER_CHANNEL=80
MAX_SOURCE_LINKS=8

# Summary engine (optional, but recommended for quality)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

DATABASE_PATH=.data/bulletins.db
